---
import SectionHead from './SectionHead.astro';
import { dict, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dict[lang].pricing;
---

<section id="pricing" class="bg-card">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
    <SectionHead title={t.title} sub={t.sub} />

    <div class="grid gap-6 lg:grid-cols-3">
      {
        t.items.map((item, i) => {
          const featured = i === 1;
          return (
            <article
              data-build
              class:list={[
                'flex flex-col rounded-[28px] p-8',
                featured ? 'border-2 border-violet bg-paper' : 'bg-paper',
              ]}
            >
              <h3 class="text-xl font-extrabold">{item.name}</h3>
              <p class="mt-4 text-3xl font-black text-violet sm:text-4xl">{item.price}</p>
              <p class="mt-1 text-sm font-medium text-muted">
                {item.time}{featured && <span class="text-violet"> · {t.popular}</span>}
              </p>
              <ul class="mt-7 flex-1 space-y-3">
                {item.features.map((feature) => (
                  <li class="flex items-start gap-3 text-[15px] leading-snug">
                    <svg
                      class="mt-1 h-3.5 w-3.5 shrink-0 text-mint"
                      viewBox="0 0 14 14"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="M2 7.5 L5.5 11 L12 3.5"
                        stroke="currentColor"
                        stroke-width="2.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                    <span class="text-muted">{feature}</span>
                  </li>
                ))}
              </ul>
              <a href="#contact" class="btn-violet mt-8">{t.cta}</a>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
