---
import SectionHead from './SectionHead.astro';
import { dict, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dict[lang].testimonials;

---

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
  <SectionHead title={t.title} />

  <div class="grid gap-6 md:grid-cols-3">
    {
      t.items.map((item) => (
        <figure data-build class="card-soft flex flex-col p-7">
          <blockquote class="flex-1 leading-relaxed text-ink/85">{item.text}</blockquote>
          <figcaption class="mt-6 border-t border-ink/10 pt-4">
            <span class="block text-sm font-bold">{item.author}</span>
            <span class="block text-xs text-muted">{item.role}</span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>
