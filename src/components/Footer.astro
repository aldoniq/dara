---
import { dict, langs, langNames, langPath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dict[lang];

const year = new Date().getFullYear();
---

<footer class="bg-paper pb-10">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mt-10 flex flex-col items-center justify-between gap-6 border-t border-ink/10 pt-8 sm:flex-row">
      <div class="text-center sm:text-left">
        <p class="flex items-center justify-center gap-1.5 text-lg font-black text-violet sm:justify-start">
          dara<svg width="12" height="12" viewBox="0 0 14 14" aria-hidden="true" class="mt-0.5">
            <circle cx="7" cy="3" r="2.6" fill="var(--color-lemon)"></circle>
            <circle cx="11" cy="7" r="2.6" fill="var(--color-lemon)"></circle>
            <circle cx="7" cy="11" r="2.6" fill="var(--color-lemon)"></circle>
            <circle cx="3" cy="7" r="2.6" fill="var(--color-lemon)"></circle>
            <circle cx="7" cy="7" r="2" fill="var(--color-violet)"></circle>
          </svg>
        </p>
        <p class="mt-1 text-sm font-semibold">{t.footer.tagline}</p>
        <p class="mt-1 text-xs font-medium text-muted">{t.footer.status}</p>
      </div>

      <nav class="flex items-center gap-2 text-xs font-bold" aria-label={t.footer.langLabel}>
        {
          langs.map((l) => (
            <a
              href={langPath(l)}
              class:list={[
                'rounded-full px-4 py-2',
                l === lang ? 'bg-violet text-white' : 'bg-lilac text-ink/70 hover:text-violet',
              ]}
              aria-current={l === lang ? 'page' : undefined}
            >
              {langNames[l]}
            </a>
          ))
        }
      </nav>

      <p class="text-xs font-medium text-muted">© {year} {t.footer.rights}</p>
    </div>
  </div>
</footer>
