---
import { dict, langs, langNames, langPath, type Lang } from '../i18n';
import { splitWords } from '../lib/split';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dict[lang];

const wordmark = splitWords('dara✿');
---

<footer class="bg-paper pb-10">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <p
      data-split-rise
      class="pointer-events-none mt-10 text-center text-[19vw] leading-none font-black tracking-tight text-lilac select-none lg:text-[13rem]"
      aria-hidden="true"
    >
      {
        wordmark.map((word) => (
          <span class="split-word">
            {word.map((ch) => (
              <span class:list={['split-char', ch === '✿' && 'text-rose']} data-char>
                {ch}
              </span>
            ))}
          </span>
        ))
      }
    </p>

    <div class="mt-8 flex flex-col items-center justify-between gap-6 border-t border-ink/10 pt-8 sm:flex-row">
      <div class="text-center sm:text-left">
        <p class="text-sm font-extrabold">{t.footer.tagline}</p>
        <p class="mt-1.5 flex items-center justify-center gap-2 text-xs font-medium text-muted sm:justify-start">
          <span class="h-2 w-2 rounded-full bg-mint" aria-hidden="true"></span>
          {t.footer.status}
        </p>
      </div>

      <nav class="flex items-center gap-2 text-xs font-bold" aria-label={t.footer.langLabel}>
        {
          langs.map((l) => (
            <a
              href={langPath(l)}
              class:list={[
                'rounded-full px-4 py-2',
                l === lang ? 'bg-violet text-white' : 'bg-lilac text-ink/70 hover:text-violet',
              ]}
              aria-current={l === lang ? 'page' : undefined}
            >
              {langNames[l]}
            </a>
          ))
        }
      </nav>

      <p class="text-xs font-medium text-muted">{t.footer.rights}</p>
    </div>
  </div>
</footer>
