---
interface Props {
  title: string;
  sub?: string;
}

const { title, sub } = Astro.props;
---

<div class="mb-10 max-w-2xl sm:mb-14" data-fade>
  <h2 class="text-3xl font-black tracking-tight sm:text-5xl">{title}</h2>
  {sub && <p class="mt-4 text-lg leading-relaxed text-muted">{sub}</p>}
</div>
