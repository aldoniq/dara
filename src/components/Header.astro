---
import { dict, langs, langNames, langPath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dict[lang];

const links = [
  { href: '#services', label: t.nav.services },
  { href: '#cases', label: t.nav.cases },
  { href: '#process', label: t.nav.process },
  { href: '#pricing', label: t.nav.pricing },
  { href: '#faq', label: t.nav.faq },
];
---

<header class="sticky top-0 z-40 bg-paper/90 backdrop-blur">
  <div class="mx-auto flex h-[76px] max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href={langPath(lang)} class="flex items-center gap-1 text-2xl font-black text-violet">
      dara<svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" class="mt-1">
        <circle cx="7" cy="3" r="2.6" fill="var(--color-lemon)"></circle>
        <circle cx="11" cy="7" r="2.6" fill="var(--color-lemon)"></circle>
        <circle cx="7" cy="11" r="2.6" fill="var(--color-lemon)"></circle>
        <circle cx="3" cy="7" r="2.6" fill="var(--color-lemon)"></circle>
        <circle cx="7" cy="7" r="2" fill="var(--color-violet)"></circle>
      </svg>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Main">
      {
        links.map((link) => (
          <a href={link.href} class="text-[15px] font-medium hover:text-violet">
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <div class="flex items-center rounded-full bg-lilac p-1 text-xs font-bold">
        {
          langs.map((l) => (
            <a
              href={langPath(l)}
              class:list={[
                'rounded-full px-2.5 py-1.5',
                l === lang ? 'bg-violet text-white' : 'text-ink/70 hover:text-violet',
              ]}
              aria-current={l === lang ? 'page' : undefined}
            >
              {langNames[l]}
            </a>
          ))
        }
      </div>

      <a href="#contact" class="btn-violet hidden !px-6 !py-3 !text-sm sm:inline-flex">{t.nav.cta}</a>

      <button
        id="burger"
        class="flex h-11 w-11 items-center justify-center rounded-full bg-lilac text-violet lg:hidden"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true">
          <path d="M1 1h14M1 6h14M1 11h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden bg-paper px-4 py-5 shadow-soft lg:hidden" aria-label="Mobile">
    <div class="flex flex-col gap-1">
      {
        links.map((link) => (
          <a href={link.href} class="rounded-2xl px-4 py-3 text-lg font-bold hover:bg-lilac">
            {link.label}
          </a>
        ))
      }
      <a href="#contact" class="btn-violet mt-3">{t.nav.cta}</a>
    </div>
  </nav>
</header>
