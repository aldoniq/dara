---
import SectionHead from './SectionHead.astro';
import { dict, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dict[lang].cases;

const looks = [
  { soft: 'bg-peach', strong: 'bg-orange', text: 'text-orange', variant: 'shop' },
  { soft: 'bg-lilac', strong: 'bg-violet', text: 'text-violet', variant: 'app' },
  { soft: 'bg-sage', strong: 'bg-mint', text: 'text-mint', variant: 'corp' },
] as const;
---

<section id="cases" class="bg-card">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
    <SectionHead index="02" title={t.title} sub={t.sub} accent="orange" />

    <div class="grid gap-6 lg:grid-cols-3">
      {
        t.items.map((item, i) => {
          const look = looks[i % looks.length];
          return (
            <article
              data-build
              class="group flex flex-col overflow-hidden rounded-[28px] bg-paper transition-transform duration-200 hover:-translate-y-2"
            >
              {/* Мокап проекта, нарисованный вёрсткой */}
              <div class:list={['m-4 mb-0 h-48 rounded-3xl p-4 sm:h-52', look.soft]}>
                {look.variant === 'shop' && (
                  <div class="grid h-full grid-cols-3 gap-2.5">
                    {[...Array(6)].map((_, j) => (
                      <div class="flex flex-col gap-1.5 rounded-xl bg-white/80 p-2">
                        <div class:list={['flex-1 rounded-lg', j % 2 ? look.soft : 'bg-ink/5']} />
                        <div class="h-1.5 w-3/4 rounded-full bg-ink/10" />
                        <div class:list={['h-1.5 w-1/2 rounded-full', look.strong]} />
                      </div>
                    ))}
                  </div>
                )}
                {look.variant === 'app' && (
                  <div class="flex h-full gap-2.5">
                    <div class="flex w-1/4 flex-col gap-2 rounded-xl bg-white/80 p-2">
                      {[...Array(4)].map((_, j) => (
                        <div class:list={['h-2 rounded-full', j === 0 ? look.strong : 'bg-ink/10']} />
                      ))}
                    </div>
                    <div class="flex flex-1 flex-col gap-2.5">
                      <div class="flex gap-2.5">
                        {[...Array(3)].map((_, j) => (
                          <div class:list={['h-9 flex-1 rounded-xl', j === 1 ? 'bg-white/80' : 'bg-white/50']} />
                        ))}
                      </div>
                      <div class="flex-1 rounded-xl bg-white/80 p-2">
                        <div class="grid h-full grid-cols-7 gap-1.5">
                          {[...Array(21)].map((_, j) => (
                            <div class:list={['rounded-md', [3, 8, 12, 17].includes(j) ? look.strong : 'bg-ink/5']} />
                          ))}
                        </div>
                      </div>
                    </div>
                  </div>
                )}
                {look.variant === 'corp' && (
                  <div class="flex h-full flex-col gap-2.5">
                    <div class="flex flex-1 flex-col justify-center gap-2 rounded-xl bg-white/80 px-4">
                      <div class="h-2.5 w-2/3 rounded-full bg-ink/25" />
                      <div class="h-1.5 w-1/2 rounded-full bg-ink/10" />
                      <div class:list={['mt-1.5 h-5 w-20 rounded-full', look.strong]} />
                    </div>
                    <div class="flex gap-2.5">
                      {[...Array(3)].map(() => (
                        <div class="h-11 flex-1 rounded-xl bg-white/60" />
                      ))}
                    </div>
                  </div>
                )}
              </div>

              <div class="flex flex-1 flex-col p-6">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h3 class="text-xl font-extrabold">{item.name}</h3>
                    <p class="mt-0.5 text-xs font-medium text-muted">{item.type}</p>
                  </div>
                  <div class="text-right">
                    <p class:list={['text-2xl font-black', look.text]}>{item.metric}</p>
                    <p class="text-[11px] font-medium text-muted">{item.metricLabel}</p>
                  </div>
                </div>
                <p class="mt-3 flex-1 text-[15px] leading-relaxed text-muted">{item.desc}</p>
                <div class="mt-4 flex flex-wrap gap-2">
                  {item.tags.map((tag) => (
                    <span class="chip bg-white">{tag}</span>
                  ))}
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
