---
import SectionHead from './SectionHead.astro';
import { dict, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dict[lang].faq;
---

<section id="faq" class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-24">
  <SectionHead index="06" title={t.title} accent="violet" />

  <div class="space-y-4">
    {
      t.items.map((item) => (
        <details data-build class="card-soft group overflow-hidden">
          <summary class="flex cursor-pointer items-center justify-between gap-4 p-6 text-base font-extrabold sm:text-lg [&::-webkit-details-marker]:hidden">
            {item.q}
            <span
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-lilac text-lg font-bold text-violet transition-transform duration-200 group-open:rotate-45"
              aria-hidden="true"
            >
              +
            </span>
          </summary>
          <p class="px-6 pb-6 leading-relaxed text-muted">{item.a}</p>
        </details>
      ))
    }
  </div>
</section>
