---
import SectionHead from './SectionHead.astro';
import { dict, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dict[lang].services;

const looks = [
  { bg: 'bg-lilac', emoji: '🚀' },
  { bg: 'bg-peach', emoji: '🛍️' },
  { bg: 'bg-sage', emoji: '⚙️' },
  { bg: 'bg-rose', emoji: '📈' },
];
---

<section id="services" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
  <SectionHead title={t.title} sub={t.sub} accent="violet" emoji="✦" />

  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {
      t.items.map((item, i) => (
        <article
          data-build
          class:list={[
            'flex flex-col rounded-[28px] p-7 transition-transform duration-200 hover:-translate-y-2 hover:-rotate-1',
            looks[i].bg,
          ]}
        >
          <span class="text-3xl" aria-hidden="true">
            {looks[i].emoji}
          </span>
          <h3 class="mt-5 text-xl font-extrabold">{item.title}</h3>
          <p class="mt-2.5 flex-1 text-[15px] leading-relaxed text-muted">{item.desc}</p>
          <div class="mt-5 flex flex-wrap gap-2">
            {item.tags.map((tag) => (
              <span class="chip bg-white/70">{tag}</span>
            ))}
          </div>
        </article>
      ))
    }
  </div>
</section>
